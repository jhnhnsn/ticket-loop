#!/usr/bin/env python3
"""The ticket-loop run store: the one way to write a run record.

  ticket-loop-record write <record.json>             add a record to the store
  ticket-loop-record write --followup <record.json>  add <record>.followup.json next to it
  ticket-loop-record pull                            pull the store from its remote
  ticket-loop-record due [<project>]                 print the project's records older
                                                     than 14 days with no followup,
                                                     one compact JSON record per line;
                                                     with no project, the one below
  ticket-loop-record project                         print the project value for the
                                                     repo in the current folder: its
                                                     origin repo name, or _sandbox for
                                                     ticket-loop-sandbox

`project` and `due` with no project exit 1 when the current folder has no
readable origin remote: the run must not guess a name.

The store is a git repo at $TICKET_LOOP_HOME (default ~/.ticket-loop/). Each
record is one file, runs/<project>/<date>-<ticket>-<run ID>.json, and never
changes. $TICKET_LOOP_STORE_REMOTE names a private remote: a write pushes after
its commit, and the first write on a new machine clones it. Without a remote,
the first write makes a local repo.

The script never fails a run: every store outcome exits 0 with one line on
stdout for the ticket report. Only no readable origin remote (for `project` and
`due` with no project) exits 1, and only wrong usage exits 2. A project opts out with
a `## Run records` section of `Off.` in docs/agents/ticket-loop.md (the current
directory's loop config).

Test hooks (environment):
  TICKET_LOOP_HOME          the store folder in place of ~/.ticket-loop/
  TICKET_LOOP_STORE_REMOTE  the remote URL; a local bare repo works in tests
"""
import datetime
import json
import os
import re
import subprocess
import sys

BRANCH = "main"
CONFIG = os.path.join("docs", "agents", "ticket-loop.md")
PROJECT = re.compile(r"^[A-Za-z0-9._-]+$")
DATE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
RUN_ID = re.compile(r"^[A-Za-z0-9._:-]+$")
FOLLOWUP_DAYS = 14
SAFE = "letters, digits, '.', '_' and '-'"
SANDBOX_REPO = "ticket-loop-sandbox"
NO_PROJECT = "run store: no project (no readable origin remote)"


def store_path():
    return os.path.expanduser(os.environ.get("TICKET_LOOP_HOME") or "~/.ticket-loop")


def remote():
    return os.environ.get("TICKET_LOOP_STORE_REMOTE") or None


def git(store, *args):
    try:
        r = subprocess.run(["git", "-C", store, *args], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def opted_out(config=CONFIG):
    try:
        with open(config) as f:
            text = f.read()
    except OSError:
        return False
    m = re.search(r"^## Run records[ \t]*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return bool(m) and m.group(1).strip() == "Off."


def check(record):
    """The reason the record is not valid, or None. Checks only the fields the store needs."""
    if not isinstance(record, dict):
        return "not a JSON object"
    for field in ("project", "date", "ticket", "run_id"):
        if field not in record:
            return f"{field} is missing"
    if not isinstance(record["project"], str) or not PROJECT.match(record["project"]) \
            or record["project"] in (".", ".."):
        return f"project has characters other than {SAFE}"
    if not isinstance(record["date"], str) or not DATE.match(record["date"]):
        return "date is not YYYY-MM-DD"
    ticket = record["ticket"]
    if isinstance(ticket, bool) or not (isinstance(ticket, int) or
                                        (isinstance(ticket, str) and ticket.isdigit())):
        return "ticket is not a number"
    if not isinstance(record["run_id"], str) or not RUN_ID.match(record["run_id"]):
        return f"run_id has characters other than {SAFE} and ':'"
    if "repos" in record:
        # A multi-repo ticket: each changed repo other than the home repo, with its commits.
        repos = record["repos"]
        if not isinstance(repos, list):
            return "repos is not a list"
        for entry in repos:
            if not (isinstance(entry, dict) and isinstance(entry.get("repo"), str)
                    and entry["repo"] and isinstance(entry.get("commits"), list)
                    and all(isinstance(c, str) for c in entry["commits"])):
                return "each repos entry needs a repo and a list of commits"
    return None


def record_name(record, followup=False):
    base = f"{record['date']}-{record['ticket']}-{record['run_id']}"
    return f"runs/{record['project']}/{base}{'.followup' if followup else ''}.json"


def open_store(store, url):
    """Make the store ready for a write: clone or init it at first write. True if ready."""
    if not os.path.isdir(os.path.join(store, ".git")):
        if url and not os.path.exists(store):
            parent = os.path.dirname(os.path.abspath(store))
            os.makedirs(parent, exist_ok=True)
            if not git(parent, "clone", "-q", url, store):
                return False
        else:
            os.makedirs(store, exist_ok=True)
            if not git(store, "init", "-q", "-b", BRANCH):
                return False
    git(store, "symbolic-ref", "HEAD", f"refs/heads/{BRANCH}")
    if url and not git(store, "remote", "get-url", "origin"):
        git(store, "remote", "add", "origin", url)
    return True


def sync_push(store):
    """Pull new records, then push local commits. True if the push went through."""
    git(store, "pull", "-q", "--rebase", "origin", BRANCH)
    return git(store, "push", "-q", "origin", f"HEAD:{BRANCH}")


def write(path, followup=False):
    if opted_out():
        return "run record: not written (off in the loop config)"
    try:
        with open(path) as f:
            record = json.load(f)
    except (OSError, ValueError):
        record = None
    reason = check(record)
    if reason:
        return f"run record: not written (record not valid: {reason})"
    store, url = store_path(), remote()
    try:
        if not open_store(store, url):
            return "run record: not written (store not available)"
        if url:
            git(store, "pull", "-q", "--rebase", "origin", BRANCH)
        name = record_name(record, followup)
        target = os.path.join(store, name)
        if followup and not os.path.exists(os.path.join(store, record_name(record))):
            return f"run record: not written (no record for the followup: {record_name(record)})"
        if os.path.exists(target):
            return f"run record: not written (record exists: {name})"
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "x") as f:
            json.dump(record, f, indent=2, sort_keys=True)
            f.write("\n")
        if not (git(store, "add", "--", name) and
                git(store, "commit", "-q", "-m", f"Add {name}", "--", name)):
            os.remove(target)
            return "run record: not written (store not available)"
    except OSError:
        return "run record: not written (store not available)"
    if not url:
        return f"run record: written ({name}, no remote)"
    if sync_push(store):
        return f"run record: written ({name}, pushed)"
    return (f"run record: written ({name}), push failed: the commit stays local,"
            " and the next write pushes it")


def pull():
    store, url = store_path(), remote()
    if not os.path.isdir(os.path.join(store, ".git")):
        return "run store: not pulled (no store yet)"
    if not url:
        return "run store: not pulled (no remote)"
    if not git(store, "remote", "get-url", "origin"):
        git(store, "remote", "add", "origin", url)
    if not git(store, "pull", "-q", "--rebase", "origin", BRANCH):
        return "run store: not pulled (remote not available)"
    return "run store: pulled"


def project(repo="."):
    """The project value for the repo at repo: its origin repo name, or _sandbox for
    the sandbox repo. None with no readable origin remote."""
    try:
        r = subprocess.run(["git", "-C", repo, "remote", "get-url", "origin"],
                           capture_output=True, text=True, stdin=subprocess.DEVNULL,
                           timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    url = r.stdout.strip().rstrip("/")
    if r.returncode != 0 or not url:
        return None
    name = re.split(r"[/:]", url)[-1]
    if name.endswith(".git"):
        name = name[:-len(".git")]
    if name == SANDBOX_REPO:
        return "_sandbox"
    if not PROJECT.match(name) or name in (".", ".."):
        return None
    return name


def due(project, today=None):
    """The project's records older than FOLLOWUP_DAYS with no followup, one per line
    as compact JSON. A record file that is not a JSON object is skipped."""
    store = store_path()
    folder = os.path.join(store, "runs", project)
    if not os.path.isdir(os.path.join(store, ".git")):
        return "run store: no records due (no store yet)"
    if not os.path.isdir(folder):
        return f"run store: no records for project {project}"
    today = today or datetime.date.today()
    names = os.listdir(folder)
    found = []
    for n in sorted(names):
        if not n.endswith(".json") or n.endswith(".followup.json"):
            continue
        try:
            day = datetime.date.fromisoformat(n[:10])
        except ValueError:
            continue
        if (today - day).days > FOLLOWUP_DAYS and \
                n[:-len(".json")] + ".followup.json" not in names:
            try:
                with open(os.path.join(folder, n)) as f:
                    record = json.load(f)
            except (OSError, ValueError):
                continue
            if isinstance(record, dict):
                found.append(json.dumps(record, sort_keys=True, separators=(",", ":")))
    return "\n".join(found) or "run store: no records due"


def main(argv):
    if argv in (["project"], ["due"]):
        name = project()
        if not name:
            print(NO_PROJECT)
            return 1
        print(name if argv == ["project"] else due(name))
        return 0
    if argv[:1] == ["due"] and len(argv) == 2 and PROJECT.match(argv[1]) \
            and argv[1] not in (".", ".."):
        print(due(argv[1]))
        return 0
    if argv[:1] == ["pull"] and len(argv) == 1:
        print(pull())
        return 0
    if argv[:1] == ["write"] and len(argv) == 2:
        print(write(argv[1]))
        return 0
    if argv[:2] == ["write", "--followup"] and len(argv) == 3:
        print(write(argv[2], followup=True))
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
