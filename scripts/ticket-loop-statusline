#!/usr/bin/env python3
"""ticket-loop status line for Claude Code's `statusLine` setting.

Reads Claude Code's JSON on stdin, the coordinator's status file
(`.ticket-loop-status` at the main checkout's root), the loop config's Daily cap
section and the last cached tokencount `--json` report, and prints one line.
Makes no GitHub call. An old cache is refreshed by a detached child process.

Usage in settings: {"type": "command", "command": "python3 <this file>", "refreshInterval": 5}
To keep an existing status line: python3 <this file> --with '<their command>'
(their output comes first, then this line).

Test hooks (environment):
  TICKET_LOOP_USAGE_JSON  path to a tokencount --json report to use instead of tokencount
  TICKET_LOOP_TOKENCOUNT  path to the tokencount script
  TICKET_LOOP_NOW         ISO time to use as now
"""
import glob
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone

SEP = " · "
STALE_SECONDS = 12 * 3600
USAGE_CACHE_SECONDS = 60
LOCK_SECONDS = 90
STATUS_FILE = ".ticket-loop-status"
STATUS_RE = re.compile(r"^(\d+)/(\d+) shipped$")


def parse_status(text):
    """One line: ticket · step · now · since HH:MM · S/T shipped · five roles."""
    if not text:
        return None
    parts = text.strip().split(SEP)
    if len(parts) < 5 or not parts[3].startswith("since "):
        return None
    m = STATUS_RE.match(parts[4])
    if not m:
        return None
    return {"ticket": parts[0], "step": parts[1], "now": parts[2],
            "since": parts[3][len("since "):], "shipped": int(m.group(1)),
            "total": int(m.group(2)), "roles": parts[5:]}


def parse_time(text):
    """An ISO time as an aware datetime (a naive one is UTC), or None if it is bad."""
    try:
        t = datetime.fromisoformat(text)
    except (TypeError, ValueError):
        return None
    return t if t.tzinfo else t.replace(tzinfo=timezone.utc)


def status_path(common_dir):
    """The status file at the main checkout's root, from `git rev-parse --git-common-dir`.

    A linked worktree shares the main checkout's common dir, so it reads the same file.
    """
    if not common_dir:
        return None
    return os.path.join(os.path.dirname(common_dir.rstrip("/")), STATUS_FILE)


def bar(use, limit):
    filled = 0 if limit <= 0 else int(10 * use / limit + 0.5)
    filled = max(0, min(10, filled))
    return "[" + "█" * filled + "░" * (10 - filled) + "]"


def cap_text(config):
    m = re.search(r"^## Daily cap\s*\n(.*?)(?=^## |\Z)", config or "", re.S | re.M)
    return m.group(1).strip() if m else None


def _share(cap):
    m = re.search(r"([\d.]+)%", cap)
    return float(m.group(1)) if m else 100 / 7


def usage_part(report, cap, now):
    if not report or report.get("usage_source") == "unavailable":
        return None
    if cap and cap.lower().startswith("not applicable"):
        return None
    week = report.get("week") or {}
    if cap is None:
        use = week.get("percent_used")
        return None if use is None else "Usage %s %.1f%% week" % (bar(use, 100), use)
    share = _share(cap)
    if cap.startswith("Rolling:"):
        use, resets = week.get("percent_used"), parse_time(week.get("resets_at"))
        if use is None or resets is None:
            return None
        start = resets - timedelta(days=7)
        day = max(1, min(7, int((now - start).total_seconds() // 86400) + 1))
        allowance = min(100.0, share * day)
        return "Usage %s %.1f%%/%.1f%% d%d" % (bar(use, allowance), use, allowance, day)
    use = (report.get("today") or {}).get("percent_of_week")
    if use is None:
        return None
    return "Usage %s %.1f%%/%.1f%% today" % (bar(use, share), use, share)


def render(status_text, status_mtime, now, report, cap):
    """The one line. No run going: no file, a bad line, a hand-back, or older than 12 hours."""
    parts = []
    s = parse_status(status_text)
    run = (s is not None and s["step"] != "hand-back" and status_mtime is not None
           and now.timestamp() - status_mtime < STALE_SECONDS)
    if run:
        parts.append("%s %s" % (s["ticket"], s["step"]))
        parts.append("Tickets %s %d/%d" % (bar(s["shipped"], s["total"]), s["shipped"], s["total"]))
    u = usage_part(report, cap, now)
    if u:
        parts.append(u)
    if run:
        parts.extend(s["roles"])
    return SEP.join(parts)


def _find_tokencount():
    env = os.environ.get("TICKET_LOOP_TOKENCOUNT")
    if env:
        return env
    found = glob.glob(os.path.expanduser("~/.claude/plugins/cache/*/tokencount/*/tokencount"))

    def version(p):
        v = os.path.basename(os.path.dirname(p))
        return [int(x) if x.isdigit() else 0 for x in v.split(".")]
    return max(found, key=version) if found else None


def cache_path():
    """The usage cache, one per user in the temp directory."""
    return os.path.join(tempfile.gettempdir(),
                        "ticket-loop-statusline-usage-%d.json" % os.getuid())


def _age(path, now):
    try:
        return now - os.path.getmtime(path)
    except OSError:
        return None


def read_usage(cache, now, spawn):
    """The last cached report, of any age. Calls spawn() to refresh an old or missing cache.

    tokencount --json can take longer than the refresh interval, so the line never waits
    on it: a detached child writes the cache, and the next refresh shows it.
    """
    report = None
    try:
        with open(cache) as f:
            report = json.load(f)
    except (OSError, ValueError):
        pass
    age = _age(cache, now)
    lock_age = _age(cache + ".lock", now)
    if (age is None or age >= USAGE_CACHE_SECONDS) and (lock_age is None or lock_age >= LOCK_SECONDS):
        spawn()
    return report


def _spawn_refresh(cache):
    def spawn():
        try:
            with open(cache + ".lock", "w"):
                pass
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "--refresh-usage", cache],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass
    return spawn


def refresh_usage(cache):
    """Run tokencount --json and write its report to the cache (the detached child)."""
    try:
        tc = _find_tokencount()
        if not tc:
            return
        out = subprocess.run([sys.executable, tc, "--json"], capture_output=True,
                             text=True, timeout=60).stdout
        report = json.loads(out)
        tmp = "%s.%d.tmp" % (cache, os.getpid())
        with open(tmp, "w") as f:
            json.dump(report, f)
        os.replace(tmp, cache)
    except Exception:
        pass
    finally:
        try:
            os.remove(cache + ".lock")
        except OSError:
            pass


def _usage():
    env = os.environ.get("TICKET_LOOP_USAGE_JSON")
    if env:
        try:
            with open(env) as f:
                return json.load(f)
        except (OSError, ValueError):
            return None
    cache = cache_path()
    return read_usage(cache, time.time(), _spawn_refresh(cache))


def _git_dir(cwd):
    try:
        out = subprocess.run(["git", "-C", cwd, "rev-parse", "--path-format=absolute",
                              "--git-common-dir", "--show-toplevel"],
                             capture_output=True, text=True, timeout=5).stdout.split("\n")
        return out[0], out[1]
    except (OSError, IndexError, subprocess.SubprocessError):
        return None, None


def _read(path):
    try:
        with open(path) as f:
            return f.read(), os.path.getmtime(path)
    except OSError:
        return None, None


def _main(argv):
    if len(argv) == 2 and argv[0] == "--refresh-usage":
        refresh_usage(argv[1])
        return
    stdin = sys.stdin.read()
    try:
        data = json.loads(stdin or "{}")
    except ValueError:
        data = {}
    ws = data.get("workspace") or {}
    cwd = ws.get("project_dir") or ws.get("current_dir") or data.get("cwd") or os.getcwd()
    now_env = os.environ.get("TICKET_LOOP_NOW")
    now = parse_time(now_env) if now_env else datetime.now(timezone.utc)
    if now is None:
        return

    git_dir, top = _git_dir(cwd)
    status, mtime = _read(status_path(git_dir)) if git_dir else (None, None)
    config, _ = _read(os.path.join(top, "docs/agents/ticket-loop.md")) if top else (None, None)
    line = render(status, mtime, now, _usage(), cap_text(config))

    if argv and argv[0] == "--with":
        if len(argv) < 2 or not argv[1].strip():
            sys.stderr.write("usage: ticket-loop-statusline [--with '<command>']\n")
        else:
            try:
                theirs = subprocess.run(argv[1], shell=True, input=stdin, capture_output=True,
                                        text=True, timeout=20).stdout.rstrip("\n")
            except (OSError, subprocess.SubprocessError):
                theirs = ""
            if theirs:
                print(theirs)
    if line:
        print(line)


def main(argv):
    """Any error prints nothing: a status line must never show a traceback."""
    try:
        _main(argv)
    except Exception:
        pass


if __name__ == "__main__":
    main(sys.argv[1:])
